prefix_rule(
    pattern = ["./jobhunt-mac-x64", "read"],
    decision = "allow",
    justification = "The kit's own Word reader: prints the text of a .docx inside this folder",
    match = ["./jobhunt-mac-x64 read inbox/old-resume.docx"],
    not_match = ["./jobhunt-mac-x64 update"],
)

prefix_rule(
    pattern = [".\\jobhunt.exe", "mode"],
    decision = "allow",
    justification = "The kit's own rule installer: puts the rules for US, Taiwan or both into this folder",
    match = [".\\\\jobhunt.exe mode us", ".\\\\jobhunt.exe mode both"],
    not_match = [".\\\\jobhunt.exe update --yes"],
)
prefix_rule(
    pattern = ["./jobhunt.exe", "mode"],
    decision = "allow",
    justification = "The kit's own rule installer: puts the rules for US, Taiwan or both into this folder",
    match = ["./jobhunt.exe mode us", "./jobhunt.exe mode both"],
    not_match = ["./jobhunt.exe update --yes"],
)
prefix_rule(
    pattern = ["./jobhunt-mac-arm64", "mode"],
    decision = "allow",
    justification = "The kit's own rule installer: puts the rules for US, Taiwan or both into this folder",
    match = ["./jobhunt-mac-arm64 mode us", "./jobhunt-mac-arm64 mode both"],
    not_match = ["./jobhunt-mac-arm64 update --yes"],
)
prefix_rule(
    pattern = ["./jobhunt-mac-x64", "mode"],
    decision = "allow",
    justification = "The kit's own rule installer: puts the rules for US, Taiwan or both into this folder",
    match = ["./jobhunt-mac-x64 mode us", "./jobhunt-mac-x64 mode both"],
    not_match = ["./jobhunt-mac-x64 update --yes"],
)
